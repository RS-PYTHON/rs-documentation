@startuml use-cases-external-data-sources
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #E0F2F1
  BorderColor #00796B
}
skinparam rectangle {
  BackgroundColor #F5F9FA
  BorderColor #00796B
}
skinparam actor {
  BorderColor #00796B
}
skinparam database {
  BackgroundColor #FFF8E1
  BorderColor #F9A825
}
skinparam cloud {
  BackgroundColor #EDE7F6
  BorderColor #5E35B1
}
left to right direction
actor "RS user" as user
database "Object storage\n(S3)" as s3
rectangle "Stations" {
  rectangle "CADIP" as cadip
  rectangle "AUXIP" as auxip
  rectangle "PRIP" as prip
  rectangle "LTA" as lta
}
rectangle "External data sources (rs-server)" {
  usecase "Search items" as search
  usecase "Provide a\nSTAC interface" as stac
}
rectangle "Staging (rs-server)" {
  usecase "Stage items" as stage
  usecase "Download items" as download
  usecase "Upload items" as upload
}
rectangle "IAM" {
  usecase "Access control" as access
}
user -- search
user -- stage
search ..> stac : <<include>>
search ..> access : <<include>>
stage ..> access : <<include>>
stage ..> download : <<include>>
stage ..> upload : <<include>>
search -- cadip
search -- auxip
search -- prip
download -- cadip
download -- auxip
download -- prip
download -- lta
upload -- s3
@enduml
