@startuml deployment-node-pools
skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodesep 30
skinparam ranksep 40
skinparam node {
  BackgroundColor #F5F9FA
  BorderColor #00796B
}
skinparam component {
  BackgroundColor #E0F2F1
  BorderColor #00796B
}
skinparam frame {
  BorderColor #5E35B1
}

frame "Kubernetes cluster" {
  node "infra" as infra {
    component "Core components\n(Envoy Gateway, Keycloak,\nCloudNativePG, Velero...)" as core
    component "Monitoring\n(Grafana, Prometheus,\nLoki, Tempo, Alloy)" as mon
    component "Security\n(Wazuh, NeuVector)" as sec
  }
  node "rs_server" as rsserver {
    component "rs-server services\n(frontend, catalog, cadip,\nauxip, prip, staging, osam)" as server
    component "rs-dpr-service" as dprs
    component "STAC browsers" as browsers
  }
  node "access_csc" as csc {
    component "Staging Dask cluster" as staging
  }
  node "rs_env" as env {
    component "JupyterHub" as jupyter
    component "Prefect server\nand workers" as prefect
    component "Dask Gateway" as gateway
    component "API Key Manager" as apikey
  }
  node "prefect_flow" as flows {
    component "Prefect flow runs" as runs
  }
  node "dask_scheduler" as sched {
    component "DPR Dask schedulers" as dsched
  }
  node "dask_worker_on_demand\nbig_dask_worker_on_demand" as workers {
    component "DPR Dask workers" as dworkers
  }
}
infra -[hidden]right-> rsserver
rsserver -[hidden]right-> csc
infra -[hidden]down-> env
env -[hidden]right-> flows
env -[hidden]down-> sched
sched -[hidden]right-> workers
@enduml
