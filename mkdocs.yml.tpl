site_name: RS-Python
site_description: Online documentation of the Copernicus Reference System Python (RS-Python)
site_url: https://home.rs-python.eu/rs-documentation/
repo_url: https://github.com/RS-PYTHON/rs-documentation
repo_name: RS-PYTHON/rs-documentation
# The pages come from several git repositories: the "edit this page" links would be wrong
edit_uri: ""
copyright: Copyright &copy; 2023-2026, Airbus, CS Group - Licensed under the Apache License, Version 2.0

theme:
  name: material
  custom_dir: docs/_templates
  features:
    - navigation.tabs
    - navigation.tabs.sticky
    - navigation.sections
    - navigation.top
    - navigation.tracking
    - navigation.indexes
    - navigation.path
    - navigation.footer
    - toc.follow
    - search.suggest
    - search.highlight
    - content.tabs.link
    - content.code.annotate
    - content.code.copy
  language: en
  logo: _static/rspython_logo.png
  favicon: _static/rspython_logo.png
  palette:
    - scheme: default
      toggle:
        icon: material/toggle-switch-off-outline
        name: Switch to dark mode
      primary: teal
      accent: purple
    - scheme: slate
      toggle:
        icon: material/toggle-switch
        name: Switch to light mode
      primary: teal
      accent: lime

markdown_extensions:
  - abbr
  - admonition
  - attr_list
  - def_list
  - footnotes
  - md_in_html
  - sane_lists
  - tables
  - toc:
      permalink: true
  - pymdownx.details
  - pymdownx.emoji:
      emoji_index: !!python/name:material.extensions.emoji.twemoji
      emoji_generator: !!python/name:material.extensions.emoji.to_svg
  - pymdownx.highlight:
      anchor_linenums: true
  - pymdownx.inlinehilite
  # Turn the bare URLs into links, as GitHub does
  - pymdownx.magiclink
  - pymdownx.snippets:
      # Tooltips for the acronyms, on every page
      auto_append:
        - includes/abbreviations.md
  - pymdownx.superfences:
      custom_fences:
        - name: mermaid
          class: mermaid
          format: !!python/name:pymdownx.superfences.fence_code_format
  - pymdownx.tabbed:
      alternate_style: true

extra_css: [_templates/style.css]

hooks:
  # Turn absolute GitHub links between RS-PYTHON repositories into site-internal links
  - hooks/rspy_links.py
  # Remove the boilerplate repeated in all the repositories: Contributing and Licensing sections of the READMEs,
  # license headers of the code examples
  - hooks/rspy_boilerplate.py

plugins:
  - search
  - mkdocstrings:
      handlers:
        python:
          # The Python API documentation is generated by static analysis of the source code of the
          # repositories cloned under docs/: they don't need to be installed.
          paths:
            - docs/rs-server/services/adgs
            - docs/rs-server/services/cadip
            - docs/rs-server/services/catalog
            - docs/rs-server/services/common
            - docs/rs-server/services/frontend
            - docs/rs-server/services/osam
            - docs/rs-server/services/prip
            - docs/rs-server/services/staging
            - docs/rs-client-libraries
            - docs/rs-dpr-service
          options:
            show_source: true
            docstring_options:
              # Don't spam the build logs with docstring style warnings
              warn_unknown_params: false
              warn_missing_types: false

# The RS-PYTHON repositories are cloned (or symlinked) under docs/: only publish their documentation
# (Markdown pages and images), not their source code, tests or notebooks.
exclude_docs: |
  /rs-*/**
  /actions/**
  !*.md
  !*.png
  !*.jpg
  !*.jpeg
  !*.gif
  !*.svg
  /rs-*/**/tests/**
  /rs-*/**/node_modules/**
  /rs-*/**/.venv/**
  /rs-*/**/.tox/**
  /rs-*/**/site-packages/**
  /rs-*/.github/**
  /rs-demo/notebooks/**
  /rs-server/services/*/README.md
  /rs-server/services/*/config/**
  /rs-client-libraries/config/**
  /rs-dpr-service/config/**
  /rs-workflow-env/docker/**
  /rs-helm/charts/*/templates/**
  /rs-demo/local-mode/**
  /rs-infra-core/roles/**

validation:
  omitted_files: warn
  absolute_links: info
  unrecognized_links: warn
  anchors: warn

not_in_nav: |
  /rs-*/**/*.md
  /actions/**/*.md

