@startuml architecture-components
skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle rectangle
skinparam rectangle {
  BackgroundColor #F5F9FA
  BorderColor #00796B
}
skinparam component {
  BackgroundColor #E0F2F1
  BorderColor #00796B
}
skinparam database {
  BackgroundColor #FFF8E1
  BorderColor #F9A825
}
skinparam cloud {
  BackgroundColor #EDE7F6
  BorderColor #5E35B1
}
skinparam node {
  BackgroundColor #F5F9FA
  BorderColor #00796B
}
skinparam package {
  BackgroundColor #F5F9FA
  BorderColor #00796B
}
rectangle "RS-Python" as rspy {
  rectangle "rs-server (rs-server, rs-helm)" as server {
    component "Frontend (Swagger)\nCatalog, Staging, OSAM\nCADIP, AUXIP, PRIP" as services
    component "STAC browsers" as browsers
  }
  rectangle "rs-client-libraries" as client {
    component "rs_workflows\n(Prefect flows)" as workflows
    component "rs_client\nrs_common" as rsclient
  }
  rectangle "DPR (rs-dpr-service)" as dpr {
    component "rs-dpr-service" as dprservice
    component "DPR processors\n(EOPF, Docker images)" as processors
  }
  rectangle "Virtual environment (rs-workflow-env)" as env {
    component "JupyterHub\nPrefect" as jupyter
    component "Dask Gateway\nAPI Key Manager" as gateway
  }
}
rectangle "Infrastructure" as infra {
  rectangle "Core (rs-infra-core)" as core {
    component "Kubernetes\nEnvoy Gateway\ncert-manager" as k8s
    component "Keycloak\nCloudNativePG\nVelero" as keycloak
  }
  rectangle "Monitoring (rs-infra-monitoring)" as monitoring {
    component "Grafana\nPrometheus" as grafana
    component "Loki, Tempo\nAlloy" as loki
  }
  rectangle "Security (non-public)" as security {
    component "Wazuh\nNeuVector" as wazuh
  }
}
rectangle "Physical infrastructure" as physical {
  component "Cloud provider (OpenStack, S3 object storage)\nprovisioned with Terraform and Ansible" as cloud
}
server -[hidden]right-> client
client -[hidden]right-> dpr
dpr -[hidden]right-> env
services -[hidden]down-> k8s
k8s -[hidden]down-> cloud
@enduml
