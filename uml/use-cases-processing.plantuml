@startuml use-cases-processing
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #E0F2F1
  BorderColor #00796B
}
skinparam rectangle {
  BackgroundColor #F5F9FA
  BorderColor #00796B
}
skinparam actor {
  BorderColor #00796B
}
skinparam database {
  BackgroundColor #FFF8E1
  BorderColor #F9A825
}
skinparam cloud {
  BackgroundColor #EDE7F6
  BorderColor #5E35B1
}
left to right direction
actor "RS user" as user
rectangle "Dask cluster" as dask
rectangle "DPR processors" as dprlib
rectangle "Catalog" {
  usecase "Search items" as search
  usecase "Add items" as add
}
rectangle "Processing (flows and rs-dpr-service)" {
  usecase "Generate products" as generate
  usecase "Get the task table" as tasktable
  usecase "Prepare the payload" as payload
  usecase "Stage the auxiliary\nfiles" as stageaux
  usecase "Compute the products" as compute
  usecase "Publish the\ngenerated products" as publish
}
user -- generate
generate ..> tasktable : <<include>>
generate ..> payload : <<include>>
generate ..> compute : <<include>>
generate ..> publish : <<include>>
payload ..> search : <<include>>
payload ..> stageaux : <<include>>
publish ..> add : <<include>>
tasktable -- dprlib
compute -- dask
compute -- dprlib
@enduml
