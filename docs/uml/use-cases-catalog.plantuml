@startuml use-cases-catalog
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #E0F2F1
  BorderColor #00796B
}
skinparam rectangle {
  BackgroundColor #F5F9FA
  BorderColor #00796B
}
skinparam actor {
  BorderColor #00796B
}
skinparam database {
  BackgroundColor #FFF8E1
  BorderColor #F9A825
}
skinparam cloud {
  BackgroundColor #EDE7F6
  BorderColor #5E35B1
}
left to right direction
actor "RS user" as user
database "Object storage\n(S3)" as s3
rectangle "IAM" {
  usecase "Authenticate the user" as auth
  usecase "Control access to\nthe catalog collections" as access
}
rectangle "Catalog (rs-server)" {
  usecase "Manage the STAC catalog" as manage
  usecase "Add" as add
  usecase "Update" as update
  usecase "Delete" as delete
  usecase "Search" as search
  usecase "Download" as download
  usecase "Generate a\ntemporary URL" as url
  usecase "Delete expired\nassets" as lifecycle
}
user -- auth
user -- manage
manage ..> access : <<include>>
add ..> manage : <<extend>>
update ..> manage : <<extend>>
delete ..> manage : <<extend>>
search ..> manage : <<extend>>
download ..> manage : <<extend>>
download ..> url : <<include>>
url -- s3
lifecycle -- s3
@enduml
